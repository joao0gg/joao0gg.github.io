{
  "name": "Blog",
  "image": "mcr.microsoft.com/devcontainers/ruby:3.2",
  "postCreateCommand": "bundle install",
  "remoteEnv": { "JEKYLL_ENV": "docker" },
  "forwardPorts": [4000],
  "portsAttributes": {
    "4000": { "label": "Blog", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["-shopify.ruby-lsp"],
      "settings": { "chat.disableAIFeatures": true }
    }
  }
}